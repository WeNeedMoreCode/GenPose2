#include "acl/acl.h"
#include "kernel_operator.h"

constexpr int32_t BUFFER_NUM = 1;
constexpr uint32_t TOTAL_LENGTH = 256;

class KernelAdd {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
        blockLength = TOTAL_LENGTH;
        xGm.SetGlobalBuffer((__gm__ float*)x, blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y, blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z, blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, blockLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, blockLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, blockLength * sizeof(float));
    }
    __aicore__ inline void Process() {
        CopyIn(); Compute(); CopyOut();
    }
private:
    __aicore__ inline void CopyIn() {
        auto xLocal = inQueueX.AllocTensor<float>();
        auto yLocal = inQueueY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm, blockLength);
        AscendC::DataCopy(yLocal, yGm, blockLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute() {
        auto xLocal = inQueueX.DeQue<float>();
        auto yLocal = inQueueY.DeQue<float>();
        auto zLocal = outQueueZ.AllocTensor<float>();
        AscendC::Add(zLocal, xLocal, yLocal, blockLength);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut() {
        auto zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopy(zGm, zLocal, blockLength);
        outQueueZ.FreeTensor(zLocal);
    }
private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockLength;
};

__global__ __aicore__ void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
    KernelAdd op;
    op.Init(x, y, z);
    op.Process();
}

int32_t main(int32_t argc, char *argv[]) {
    constexpr uint32_t len = TOTAL_LENGTH;
    float xHost[len], yHost[len], zHost[len];
    for (uint32_t i = 0; i < len; i++) { xHost[i] = 1.0f; yHost[i] = 2.0f; }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream;
    aclrtCreateStream(&stream);

    float *xD = nullptr, *yD = nullptr, *zD = nullptr;
    aclrtMalloc((void**)&xD, len*sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yD, len*sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, len*sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xD, len*sizeof(float), xHost, len*sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yD, len*sizeof(float), yHost, len*sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);

    add_custom<<<1, nullptr, stream>>>((GM_ADDR)xD, (GM_ADDR)yD, (GM_ADDR)zD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, len*sizeof(float), zD, len*sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);

    bool pass = true;
    for (uint32_t i = 0; i < len; i++) {
        if (zHost[i] != 3.0f) { pass = false; printf("FAIL at %d: %f\n", i, zHost[i]); break; }
    }
    printf("%s\n", pass ? "PASS" : "FAIL");

    aclrtFree(xD); aclrtFree(yD); aclrtFree(zD);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return pass ? 0 : 1;
}
